{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (local development)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan (nightly)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "NF_SANITIZE": "ON" }
    },
    {
      "name": "smlib",
      "displayName": "Release + SMLib kernel (RFC 0001)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NF_WITH_SMLIB": "ON" }
    },
    {
      "name": "occt",
      "displayName": "Release + OpenCASCADE (RFC 0001)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NF_WITH_OCCT": "ON", "NF_WITH_STUDIES": "ON" }
    },
    {
      "name": "bakeoff",
      "displayName": "Release + both kernels + USD import path (RFC 0001, 0002)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NF_WITH_SMLIB": "ON", "NF_WITH_OCCT": "ON", "NF_WITH_USD": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "smlib", "configurePreset": "smlib" },
    { "name": "occt", "configurePreset": "occt" },
    { "name": "bakeoff", "configurePreset": "bakeoff" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "smlib", "inherits": "base", "configurePreset": "smlib" },
    { "name": "occt", "inherits": "base", "configurePreset": "occt" },
    { "name": "bakeoff", "inherits": "base", "configurePreset": "bakeoff" }
  ]
}
