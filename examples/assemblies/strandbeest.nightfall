              {
                "id": "r",
                "type": "rect",
                "corner": [
                  "-a - 12 mm",
                  "-l - 12 mm"
                ],
                "size": [
                  "2 * a + 24 mm",
                  "l + 24 mm"
                ]
              },
              {
