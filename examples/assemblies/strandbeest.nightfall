{
  "format": "nightfall.part",
  "version": 2,
  "units": {
    "length": "mm",
    "angle": "deg"
  },
  "meta": {
    "name": "Strandbeest",
    "doc": "Theo Jansen's walking linkage: four legs on a two-throw crankshaft. Jansen's eleven holy numbers plus the crank radius and pivot offsets are parameters; every link outline is solved from constraints; the crank angle drives the walk."
  },
  "params": [
    {
      "name": "crank",
      "value": "30.0 deg",
      "doc": "Crank angle"
    },
    {
      "name": "a",
      "value": "38.0 mm",
      "doc": "Jansen's a: fixed pivot, horizontal"
    },
    {
      "name": "b",
      "value": "41.5 mm",
      "doc": "Jansen's b: rocker, pivot to knee"
    },
    {
      "name": "c",
      "value": "39.3 mm",
      "doc": "Jansen's c: lower link"
    },
    {
      "name": "d",
      "value": "40.1 mm",
      "doc": "Jansen's d: rocker, pivot to thigh"
    },
    {
      "name": "e",
      "value": "55.8 mm",
      "doc": "Jansen's e: rocker, knee to thigh"
    },
    {
      "name": "f",
      "value": "39.4 mm",
      "doc": "Jansen's f: thigh link"
    },
    {
      "name": "g",
      "value": "36.7 mm",
      "doc": "Jansen's g: foot, ankle to heel"
    },
    {
      "name": "h",
      "value": "65.7 mm",
      "doc": "Jansen's h: foot, heel to toe"
    },
    {
      "name": "i",
      "value": "49.0 mm",
      "doc": "Jansen's i: foot, ankle to toe"
    },
    {
      "name": "j",
      "value": "50.0 mm",
      "doc": "Jansen's j: upper crank link"
    },
    {
      "name": "k",
      "value": "61.9 mm",
      "doc": "Jansen's k: lower crank link"
    },
    {
      "name": "l",
      "value": "7.8 mm",
      "doc": "Jansen's l: fixed pivot, vertical"
    },
    {
      "name": "m",
      "value": "15.0 mm",
      "doc": "Jansen's m: crank radius"
    },
    {
      "name": "width",
      "value": "12 mm",
      "doc": "Link width"
    },
    {
      "name": "pin",
      "value": "3 mm",
      "doc": "Pin hole radius"
    },
    {
      "name": "thickness",
      "value": "4 mm",
      "doc": "Plate thickness"
    },
    {
      "name": "stack",
      "value": "45 mm",
      "doc": "Frame pin length each side"
    },
    {
      "name": "shoe",
      "value": "7 mm",
      "doc": "Foot shoe radius"
    },
    {
      "name": "length",
      "value": "50 mm",
      "doc": "Link: hole spacing (set per occurrence)"
    },
    {
      "name": "s01",
      "value": "40 mm",
      "doc": "Triangle side 0-1 (set per occurrence)"
    },
    {
      "name": "s12",
      "value": "40 mm",
      "doc": "Triangle side 1-2 (set per occurrence)"
    },
    {
      "name": "s20",
      "value": "40 mm",
      "doc": "Triangle side 2-0 (set per occurrence)"
    },
    {
      "name": "hand",
      "value": "1",
      "doc": "Triangle handedness: 1 or -1 (set per occurrence)"
    },
    {
      "name": "gx",
      "value": "(s01 * s01 + s20 * s20 - s12 * s12) / (2 * s01)",
      "doc": "Foot toe, x"
    }
  ],
  "references": [],
  "features": [],
  "history_end": null,
  "ui": {},
  "components": [
